{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "bash .cursor/hooks/block-main-push.sh",
        "timeout": 10,
        "failClosed": false
      },
      {
        "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File .cursor/hooks/block-main-push.ps1",
        "timeout": 10,
        "failClosed": false
      }
    ]
  }
}
